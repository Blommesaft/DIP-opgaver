// bubbleSort.js
let list = [7, 13, 9, 8, 4, 1, 2, 16, 0];

for (let i = list.length - 1; i >= 0; i--) {
    for (let j = 0; j <= i - 1; j++) {
        if (list[j] > list[j + 1] > 0) {
            let temp = list[j];
            list[j] = list[j+1];
            list[j+1] = temp;
        }
    }
}
console.log(list.toString()); // => 0,1,2,4,7,8,9,13,16


let targetVal = 1; // Change if you want

let left = 0;
let right = list.length - 1;

while (left <= right) {
    let mid = (left + right) / 2

    if (list[mid] == targetVal) {
        console.log(mid);
    } else if (list[mid] < targetVal) {
        left = mid + 1;
    } else {
        right = mid -1;
    }
}
