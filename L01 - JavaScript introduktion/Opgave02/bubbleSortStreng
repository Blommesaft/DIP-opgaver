// bubbleSort.js
let list = ['Hej', 'Nej', 'Jeg', 'Giver', 'Ikke', 'Samtykke', 'Prut', 'I', 'Øret'];

for (let i = list.length - 1; i >= 0; i--) {
    for (let j = 0; j <= i - 1; j++) {
        if (list[j].localeCompare(list[j + 1]) > 0) {
            let temp = list[j];
            list[j] = list[j+1];
            list[j+1] = temp;
        }
    }
}
console.log(list); // => ["Giver", "Hej", "I", "Ikke", "Jeg", "Nej", "Øret", "Prut", "Samtykke"]